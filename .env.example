# --- Server ---
API_HOST=9090
NODE_ENV=LOCAL
RAILWAY_PUBLIC_DOMAIN=localhost

# Public URLs (used in ticket links + Monobank redirects)
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:9090

# --- Auth ---
# Long random string. Generate with: openssl rand -hex 32
JWT_SECRET=
# HMAC key used to sign QR-code payloads. Generate with: openssl rand -hex 32
QR_HMAC_SECRET=

# --- Google Sheets (direct API via service account) ---
# Sheet ID from the URL of your Google Sheet (between /d/ and /edit).
GOOGLE_SHEET_ID=
# Paste the entire service-account JSON contents here (single-line, JSON-escaped),
# OR set GOOGLE_APPLICATION_CREDENTIALS to a file path instead.
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Apps Script vars are no longer used (we switched to direct API for speed).
# You can leave the Apps Script deployment in place or delete it — it's free either way.
# APPS_SCRIPT_URL=
# APPS_SCRIPT_SECRET=

# --- Monobank Acquiring (M4) ---
# Get from your Monobank merchant cabinet: https://web.monobank.ua/
MONOBANK_TOKEN=

# --- Email (M5) ---
# Two transports. Set whichever fits your environment.
# - SENDGRID_API_KEY set → uses SendGrid HTTPS API (works from any cloud host).
# - Otherwise → uses Gmail SMTP (works from local dev, fails from most cloud hosts
#   in 2026 because Gmail blocks cloud IP ranges).

# Production (Render/Railway/Fly/Vercel/etc.):
# Get a key from https://app.sendgrid.com → Settings → API Keys (Mail Send permission).
# Verify the sender first: Settings → Sender Authentication → Single Sender Verification.
SENDGRID_API_KEY=

# Local dev: Gmail SMTP. Same SMTP_USER also doubles as the "from" address for
# both transports — SendGrid sends "Name <SMTP_USER>" using the verified sender.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ciuaschool@gmail.com
# Gmail App Password (NOT your regular Gmail password). See README for setup steps.
SMTP_PASS=

EMAIL_FROM_NAME=Deep Calls to Deep
